# Gateway
GATEWAY_API_KEY=dev-gateway-key
GATEWAY_DB_URL=sqlite+aiosqlite:///./week01/llm-gateway/data/gateway.db
GATEWAY_MAX_RETRIES=3
GATEWAY_RETRY_BASE_DELAY=0.5
GATEWAY_RETRY_MAX_DELAY=5
GATEWAY_DEFAULT_MAX_TOKENS=1024

# DeepSeek V4 Pro - OpenAI Responses protocol
DEEPSEEK_RESPONSES_BASE_URL=https://your-responses-endpoint.example/v1
DEEPSEEK_RESPONSES_API_KEY=replace-me
DEEPSEEK_RESPONSES_MODEL=deepseek-v4-pro
DEEPSEEK_RESPONSES_TIMEOUT=60
DEEPSEEK_RESPONSES_RPM=60
DEEPSEEK_RESPONSES_BURST=10

# DeepSeek V4 Flash - Anthropic Messages protocol
DEEPSEEK_MESSAGES_BASE_URL=https://your-messages-endpoint.example/v1
DEEPSEEK_MESSAGES_API_KEY=replace-me
DEEPSEEK_MESSAGES_MODEL=deepseek-v4-flash
DEEPSEEK_MESSAGES_TIMEOUT=60
DEEPSEEK_MESSAGES_RPM=60
DEEPSEEK_MESSAGES_BURST=10
ANTHROPIC_VERSION=2023-06-01
